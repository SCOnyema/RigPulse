<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RigPulse.App.ViewModels"
                    xmlns:models="clr-namespace:RigPulse.Core.Models;assembly=RigPulse.Core">

  <!-- Palette -->
  <Color x:Key="CardColor">#E6181A20</Color>
  <Color x:Key="CardBorderColor">#33FFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#FFF2F3F5</Color>
  <Color x:Key="TextSecondaryColor">#FF8B909A</Color>
  <Color x:Key="AccentColor">#FF4CC2FF</Color>
  <Color x:Key="ElevatedColor">#FFF5B83D</Color>
  <Color x:Key="CriticalColor">#FFFF5A5F</Color>
  <Color x:Key="TrackColor">#26FFFFFF</Color>

  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
  <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />

  <FontFamily x:Key="WidgetFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <!-- Windows 11 ships Segoe Fluent Icons; Windows 10 has the same glyphs in Segoe MDL2 Assets. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

  <!-- Fixed column widths shared by all rows. Card content width is 230 = 260 - 2 border - 28 padding.
       Throughput rows: label 44 + (symbol 16 + rate 72) + gap 10 + (symbol 16 + rate 72) = 230. -->
  <GridLength x:Key="LabelColumnWidth">44</GridLength>
  <GridLength x:Key="SymbolColumnWidth">16</GridLength>
  <GridLength x:Key="RateColumnWidth">72</GridLength>
  <GridLength x:Key="RateGapWidth">10</GridLength>

  <!-- Window and card -->
  <Style x:Key="WidgetWindowStyle" TargetType="Window">
    <Setter Property="Width" Value="260" />
    <Setter Property="SizeToContent" Value="Height" />
    <Setter Property="WindowStyle" Value="None" />
    <Setter Property="AllowsTransparency" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <!-- Segoe UI digits are proportional by default; tabular digits all share one width, so values
         don't jitter as they update. Inherited by every TextBlock in the window. -->
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="WidgetCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10,14,12" />
  </Style>

  <!-- Metric text -->
  <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MetricValueStyle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MetricDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>

  <Style x:Key="MetricSymbolStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricLabelStyle}" />

  <!-- Thin, animation-free bar: the stock ProgressBar template animates continuously and costs idle CPU. -->
  <Style x:Key="MetricBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource TrackBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5"
                    HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MetricRowStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- Details section -->
  <Style x:Key="DetailsDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6,0,3" />
    <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
  </Style>

  <Style x:Key="AccessHintStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Small chevron that opens and closes the details section. It sits in the card's bottom
       padding (negative bottom margin), so the compact widget barely grows. -->
  <Style x:Key="ChevronToggleStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,0,-10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip" Value="Show details" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <!-- Transparent (not null) background so the whole strip is clickable. -->
          <Border Background="Transparent">
            <TextBlock x:Name="Glyph" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                       Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE70E;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="ToolTip" Value="Hide details" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Row templates, picked automatically by view-model type -->
  <DataTemplate DataType="{x:Type vm:UsageMetricViewModel}">
    <StackPanel Style="{StaticResource MetricRowStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource LabelColumnWidth}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="36" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabelStyle}" />
        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MetricDetailStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource MetricValueStyle}" />
      </Grid>
      <ProgressBar x:Name="Bar" Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource MetricBarStyle}" />
    </StackPanel>
    <!-- Bar colour follows the load level; thresholds live in RigPulse.Core.Models.LoadLevels. -->
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LoadLevel.Elevated}">
        <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ElevatedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LoadLevel.Critical}">
        <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource CriticalBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ThroughputMetricViewModel}">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource LabelColumnWidth}" />
        <ColumnDefinition Width="{StaticResource SymbolColumnWidth}" />
        <ColumnDefinition Width="{StaticResource RateColumnWidth}" />
        <ColumnDefinition Width="{StaticResource RateGapWidth}" />
        <ColumnDefinition Width="{StaticResource SymbolColumnWidth}" />
        <ColumnDefinition Width="{StaticResource RateColumnWidth}" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MetricLabelStyle}" />
      <TextBlock Grid.Column="1" Text="{Binding FirstSymbol}" Style="{StaticResource MetricSymbolStyle}" />
      <TextBlock Grid.Column="2" Text="{Binding FirstRate}" Style="{StaticResource MetricValueStyle}" />
      <TextBlock Grid.Column="4" Text="{Binding SecondSymbol}" Style="{StaticResource MetricSymbolStyle}" />
      <TextBlock Grid.Column="5" Text="{Binding SecondRate}" Style="{StaticResource MetricValueStyle}" />
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SensorRowViewModel}">
    <Grid Margin="0,3" ToolTip="{Binding ToolTip}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource LabelColumnWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" MinWidth="36" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabelStyle}" />
      <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MetricDetailStyle}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Value}" Style="{StaticResource MetricValueStyle}" />
    </Grid>
    <!-- Temperature colour; thresholds live in RigPulse.Core.Models.TemperatureLevels. -->
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LoadLevel.Elevated}">
        <Setter TargetName="Value" Property="Foreground" Value="{StaticResource ElevatedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LoadLevel.Critical}">
        <Setter TargetName="Value" Property="Foreground" Value="{StaticResource CriticalBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
