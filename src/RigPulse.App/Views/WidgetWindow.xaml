<Window x:Class="RigPulse.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigPulse.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WidgetViewModel, IsDesignTimeCreatable=False}"
        Title="RigPulse"
        Style="{StaticResource WidgetWindowStyle}"
        WindowStartupLocation="Manual"
        Topmost="{Binding IsTopmost}"
        Opacity="{Binding Opacity}">

  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Show details" IsCheckable="True" IsChecked="{Binding IsExpanded}" />
      <MenuItem Header="Always on top" IsCheckable="True" IsChecked="{Binding IsTopmost}" />
      <MenuItem Header="Restart as administrator" Command="{Binding RestartAsAdminCommand}"
                Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource BooleanToVisibility}}" />
      <Separator />
      <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
    </ContextMenu>
  </Window.ContextMenu>

  <Border Style="{StaticResource WidgetCardStyle}">
    <StackPanel>
      <ContentControl Content="{Binding Cpu}" Focusable="False" />
      <ContentControl Content="{Binding Memory}" Focusable="False" />
      <ContentControl Content="{Binding Gpu}" Focusable="False" />
      <ContentControl Content="{Binding Disk}" Focusable="False" />
      <ContentControl Content="{Binding Network}" Focusable="False" />

      <!-- Details: hardware sensors, read only while this section is open. -->
      <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource DetailsDividerStyle}" />
        <ContentControl Content="{Binding CpuSensors}" Focusable="False" />
        <ContentControl Content="{Binding GpuSensors}" Focusable="False" />
        <ContentControl Content="{Binding Vram}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding Fans}" Focusable="False" />
        <ContentControl Content="{Binding Battery}" Focusable="False"
                        Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibility}}" />
        <TextBlock Text="{Binding AccessHint}" Style="{StaticResource AccessHintStyle}"
                   Visibility="{Binding HasAccessHint, Converter={StaticResource BooleanToVisibility}}" />
      </StackPanel>

      <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource ChevronToggleStyle}" />
    </StackPanel>
  </Border>
</Window>
